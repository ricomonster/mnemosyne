{
  "$schema": "https://opencode.ai/config.json",

  "update": "auto",

  "plugins": [
    "cc-safety-net",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js"
  ],

  "instructions": [
    "AGENTS.md",
    "agents/dum-e.md",
    "agents/edith.md",
    "agents/friday.md",
    "agents/jarvis.md",
    "agents/veronica.md"
  ],

  "default_agent": "jarvis",

  "experimental": {
    "portable_shell_scanner": true,

    "policies": [
      {
        "action": "permission",
        "resource": "read:*.env",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "read:*.env.*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "read:*.env.example",
        "effect": "allow"
      },

      {
        "action": "permission",
        "resource": "edit:*.env",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "edit:*.env.*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "edit:*.env.example",
        "effect": "allow"
      },

      {
        "action": "permission",
        "resource": "shell:*.env*",
        "effect": "deny"
      }
    ]
  },

  "mcp": {
    "servers": {
      "mem0": {
        "type": "remote",
        "url": "https://mcp.mem0.ai/mcp/",
        "headers": {
          "Authorization": "Token {env:MEM0_API_KEY}"
        },
        "oauth": false
      }
    }
  },

  "agents": {
    "jarvis": {
      "mode": "primary",
      // "model": "opencode-go/deepseek-v4.1-flash#high",
      "model": "opencode-go/claude-haiku-5-5#high",
      "steps": 60,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "allow"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },

    "edith": {
      "mode": "subagent",
      "model": "openai/gpt-6-sol#high",
      "steps": 40,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },

    "friday": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "steps": 60,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "*lint*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*test*",
          "effect": "allow"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },

    "veronica": {
      "mode": "subagent",
      "model": "openai/gpt-6-astra#high",
      "steps": 20,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },

    "dum-e": {
      "mode": "subagent",
      "model": "opencode-go/glm-5.3-flash",
      "steps": 30,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },

        {
          "action": "shell",
          "resource": "cat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "fd *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tree *",
          "effect": "allow"
        },

        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },

        {
          "action": "shell",
          "resource": "npm list *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pip list *",
          "effect": "allow"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
