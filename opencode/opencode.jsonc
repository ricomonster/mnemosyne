{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "cc-safety-net",
    "envsitter-guard@latest",
    "@dietrichgebert/ponytail"
  ],
  "instructions": [
    "AGENTS.md",
    "agents/architect.md",
    "agents/chemist.md",
    "agents/extractor.md",
    "agents/forger.md",
    "agents/point-man.md"
  ],
  "default_agent": "extractor",
  "mcp": {
    "mem0": {
      "type": "remote",
      "url": "https://mcp.mem0.ai/mcp/",
      "headers": {
        "Authorization": "Token {env:MEM0_API_KEY}"
      },
      "oauth": false
    }
  },
  "provider": {
    "opencode-go": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "agent": {
    "extractor": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "steps": 60,
      "temperature": 0.2,
      "permission": {
        "bash": {
          "find *": "allow",
          "ls *": "allow",
          "wc *": "allow",
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "architect": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "steps": 40,
      "temperature": 0.4,
      "permission": {
        "bash": {
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "forger": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "steps": 60,
      "reasoningEffort": "max",
      "temperature": 0.2,
      "permission": {
        "bash": {
          "*lint*": "allow",
          "*test*": "allow",
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        }
      }
    },
    "chemist": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5",
      "steps": 30,
      "temperature": 0.1,
      "permission": {
        "bash": {
          "cat *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "tree *": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "npm list*": "allow",
          "pip list*": "allow",
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        },
        "websearch": "deny",
        "webfetch": "deny"
      }
    },
    "point-man": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "max",
      "textVerbosity": "low",
      "steps": 40,
      "temperature": 0.1,
      "permission": {
        "bash": {
          "*": "deny"
        },
        "file": {
          "read": "deny",
          "write": "deny"
        },
        "websearch": "deny",
        "webfetch": "deny"
      }
    }
  }
}
