{
  "$schema": "https://opencode.ai/config.json",

  "update": "auto",

  "plugins": [
    "cc-safety-net",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js"
  ],

  "instructions": ["AGENTS.md"],

  "default_agent": "JARVIS",

  "experimental": {
    "portable_shell_scanner": true,

    "policies": [
      {
        "action": "permission",
        "resource": "read:*.env",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "read:*.env.*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "read:*.env.example",
        "effect": "allow"
      },

      {
        "action": "permission",
        "resource": "edit:*.env",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "edit:*.env.*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "edit:*.env.example",
        "effect": "allow"
      },

      {
        "action": "permission",
        "resource": "shell:*.env*",
        "effect": "deny"
      }
    ]
  },

  "mcp": {
    "servers": {
      "mem0": {
        "type": "remote",
        "url": "https://mcp.mem0.ai/mcp/",
        "headers": {
          "Authorization": "Token {env:MEM0_API_KEY}"
        },
        "oauth": false
      }
    }
  },

  "agents": {
    "JARVIS": {
      "mode": "primary",
      "model": "opencode-go/gemini-4-argon-contributor#medium",
      "prompt": "{file:./agents/JARVIS.md}",
      "steps": 60,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "allow"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },

    "EDITH": {
      "mode": "subagent",
      "model": "openai/gpt-6-sol#high",
      "prompt": "{file:./agents/EDITH.md}",
      "steps": 40,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },

    "FRIDAY": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "prompt": "{file:./agents/FRIDAY.md}",
      "steps": 60,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "npm run lint",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run typecheck",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm test",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npx jest",
          "effect": "allow"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },

    "VERONICA": {
      "mode": "subagent",
      "model": "openai/gpt-6-astra#high",
      "prompt": "{file:./agents/VERONICA.md}",
      "steps": 20,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },

    "DUM-E": {
      "mode": "subagent",
      "model": "opencode-go/glm-5.3-flash",
      "prompt": "{file:./agents/DUM-E.md}",
      "steps": 30,

      "permissions": [
        {
          "action": "mem0_*",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "shell",
          "resource": "cat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "fd *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tree *",
          "effect": "allow"
        },

        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },

        {
          "action": "shell",
          "resource": "npm list *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pip list *",
          "effect": "allow"
        },

        {
          "action": "shell",
          "resource": "* > *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "* >> *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*| tee *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*;*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*&&*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*||*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*$(*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*`*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*| sh*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*| bash*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*| xargs*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "find * -delete*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "find * -exec*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "find * -fprint*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "find * -fls*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "fd * -x*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "fd * --exec*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "rg * --pre*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "tree * -o*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git * --output*",
          "effect": "deny"
        },

        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },

        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
