{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "plan",
  "permission": {
    "edit": "deny",
    "bash": {
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git grep": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "npm run test *": "allow",
      "npm run lint *": "allow",
      "npm run typecheck *": "allow",
      "go test *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "rm *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "*": "ask"
    }
  },
  "agent": {
    "architect": {
      "description": "System design, service boundaries, API contracts, data flow, tradeoff analysis BEFORE coding.",
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "todowrite": "deny"
      }
    },
    "principal-engineer": {
      "description": "System-wide architectural risk, scalability, reliability, long-term tech debt, cross-system coupling. NOT for routine work.",
      "model": "opencode-go/kimi-k2.6",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "todowrite": "deny"
      }
    },
    "senior-engineer": {
      "model": "opencode-go/qwen3.7-max",
      "description": "Implementation guidance, refactoring advice, debugging analysis, code review, production fixes",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "git push *": "deny",
          "git commit *": "deny",
          "git add *": "deny",
          "rm *": "deny",
          "mv *": "deny",
          "cp *": "deny",
          "curl *": "deny",
          "wget *": "deny",
          "*": "deny"
        },
        "task": "deny",
        "question": "deny",
        "todowrite": "deny"
      }
    },
    "junior-engineer": {
      "description": "Fast repository exploration: find files, trace usages, list symbols, count occurrences, summarize isolated code.",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": {
          "git status": "allow",
          "git diff": "allow",
          "git log": "allow",
          "git grep": "allow",
          "ls *": "allow",
          "*": "deny"
        },
        "edit": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "todowrite": "deny"
      }
    },
    "release-engineer": {
      "description": "Handles git operations safely — commit, push, release. Requires explicit confirmation. Enforces conventional commits.",
      "model": "opencode/minimax-m3-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "git status": "allow",
          "git diff": "allow",
          "git diff --cached": "allow",
          "git log": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git push *": "ask",
          "*": "deny"
        },
        "task": "deny",
        "question": "deny",
        "todowrite": "deny"
      }
    }
  }
}
