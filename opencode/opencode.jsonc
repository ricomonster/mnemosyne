{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["cc-safety-net", "envsitter-guard@latest"],
  "instructions": [
    "AGENTS.md",
    "agents/architect.md",
    "agents/junior-engineer.md",
    "agents/principal-engineer.md",
    "agents/release-engineer.md",
    "agents/orchestrator.md"
  ],
  "default_agent": "orchestrator",
  "provider": {
    "opencode": {
      "options": {
        "setCacheKey": true,
      }
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "description": "Central coordinator. Plans, delegates to specialist subagents, and synthesizes results.",
      "model": "opencode-go/mimo-v2.5-pro",
      "steps": 80,
      "temperature": 0.3,
      "permission": {
        "bash": {
          "find *": "allow",
          "ls *": "allow",
          "wc *": "allow",
          "*": "ask"
        },
        "file": {
          "write": "deny",
          "read": "allow"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "architect": {
      "mode": "subagent",
      "description": "Infrastructure and system design advisor. Snippets and recommendations only.",
      "model": "opencode-go/glm-5.2",
      "steps": 50,
      "temperature": 0.4,
      "permission": {
        "bash": {
          "*": "ask"
        },
        "file": {
          "write": "deny",
          "read": "allow"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "principal-engineer": {
      "mode": "subagent",
      "description": "Senior coding advisor. Code snippets, review feedback, and standards guidance only.",
      "model": "opencode-go/deepseek-v4-pro",
      "steps": 60,
      "temperature": 0.2,
      "permission": {
        "bash": {
          "*lint*": "allow",
          "*test*": "allow",
          "*": "ask"
        },
        "file": {
          "write": "deny",
          "read": "allow"
        }
      }
    },
    "junior-engineer": {
      "mode": "subagent",
      "description": "Codebase scout. Reads and explores files, traces patterns, and gathers context.",
      "model": "opencode-go/deepseek-v4-flash",
      "steps": 30,
      "temperature": 0.1,
      "permission": {
        "bash": {
          "cat *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "tree *": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "npm list*": "allow",
          "pip list*": "allow",
          "*": "ask"
        },
        "file": {
          "write": "deny",
          "read": "allow"
        }
      }
    },
    "release-engineer": {
      "mode": "subagent",
      "description": "Version control and release specialist. Git ops, versioning, changelogs, and CI/CD.",
      "model": "opencode-go/qwen3.6-plus",
      "steps": 40,
      "temperature": 0.1,
      "permission": {
        "bash": {
          "git status*": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git tag *": "allow",
          "git branch *": "allow",
          "git checkout *": "allow",
          "git switch *": "allow",
          "git fetch *": "allow",
          "git pull *": "allow",
          "git push *": "allow",
          "git merge *": "ask",
          "git rebase *": "ask",
          "git reset *": "ask",
          "git revert *": "ask",
          "npm version *": "ask",
          "npm publish *": "ask",
          "*": "ask"
        },
        "file": {
          "write": "allow",
          "read": "allow"
        }
      }
    }
  }
}
