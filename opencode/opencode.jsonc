{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "cc-safety-net",
    "envsitter-guard@latest",
    "@dietrichgebert/ponytail"
  ],
  "instructions": [
    "AGENTS.md",
    "agents/architect.md",
    "agents/junior-engineer.md",
    "agents/principal-engineer.md",
    "agents/release-engineer.md",
    "agents/orchestrator.md"
  ],
  "default_agent": "orchestrator",
  "mcp": {
    "mem0": {
      "type": "remote",
      "url": "https://mcp.mem0.ai/mcp/",
      "headers": {
        "Authorization": "Token {env:MEM0_API_KEY}"
      },
      "oauth": false
    }
  },
  "provider": {
    "opencode-go": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "opencode-go/gpt-5.6-luna",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "steps": 60,
      "temperature": 0.2,
      "permission": {
        "bash": {
          "find *": "allow",
          "ls *": "allow",
          "wc *": "allow",
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "architect": {
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "steps": 40,
      "temperature": 0.4,
      "permission": {
        "bash": {
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "principal-engineer": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k3",
      "steps": 60,
      "temperature": 0.2,
      "permission": {
        "bash": {
          "*lint*": "allow",
          "*test*": "allow",
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        }
      }
    },
    "junior-engineer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "steps": 30,
      "temperature": 0.1,
      "permission": {
        "bash": {
          "cat *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "tree *": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "npm list*": "allow",
          "pip list*": "allow",
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        },
        "websearch": "deny",
        "webfetch": "deny"
      }
    },
    "release-engineer": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "steps": 30,
      "temperature": 0.1,
      "permission": {
        "bash": {
          "git status*": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "*": "ask"
        },
        "file": {
          "read": "allow",
          "write": "deny"
        }
      }
    }
  }
}
